#!/usr/bin/env bash
set -euo pipefail

# Local quality gate before push — mirrors `just check-local` (no SonarQube).
# Requires: just, jq, semgrep, shellcheck, cargo-audit, cargo-llvm-cov, sonar-scanner (optional).
# Install: git config core.hooksPath .githooks

# Git hooks run in a minimal env — ensure Homebrew/Cargo are on PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:$PATH"

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

just check-local
