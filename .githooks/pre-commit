#!/usr/bin/env bash
set -euo pipefail

# Fast pre-commit checks — delegates to the canonical just target.
# Install: git config core.hooksPath .githooks

# Git hooks run in a minimal env — ensure Homebrew/Cargo are on PATH.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.cargo/bin:$PATH"

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

just pre-commit
