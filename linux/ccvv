#!/usr/bin/env python3
"""ccvv for Linux — cleans clipboard text in place.

Bind this script to a keyboard shortcut in your DE/WM settings.
Requires: python3, xclip (X11) or wl-clipboard (Wayland).
"""

import re
import subprocess
import sys


def get_clipboard():
    """Read clipboard using whatever tool is available."""
    for cmd in [["wl-paste"], ["xclip", "-selection", "clipboard", "-o"]]:
        try:
            return subprocess.run(cmd, capture_output=True, text=True, check=True).stdout
        except FileNotFoundError:
            continue
    print("Install xclip or wl-clipboard", file=sys.stderr)
    sys.exit(1)


def set_clipboard(text):
    """Write text to clipboard."""
    for cmd in [["wl-copy"], ["xclip", "-selection", "clipboard"]]:
        try:
            subprocess.run(cmd, input=text, text=True, check=True)
            return
        except FileNotFoundError:
            continue
    print("Install xclip or wl-clipboard", file=sys.stderr)
    sys.exit(1)


def notify(msg):
    """Best-effort desktop notification."""
    try:
        subprocess.run(["notify-send", "ccvv", msg], check=False)
    except FileNotFoundError:
        pass


def is_list_item(line):
    return (
        line.startswith("- ")
        or line.startswith("* ")
        or bool(re.match(r"^[•◦▪]\s+", line))
        or bool(re.match(r"^\d+[.)\]] ", line))
    )


def is_list_item_with_indent(line):
    return is_list_item(line.lstrip())


def normalize_bullet_marker(line):
    return re.sub(r"^[•◦▪]\s+", "- ", line)


def is_code_fence_line(line):
    return line.lstrip().startswith("```")


def leading_whitespace(line):
    return re.match(r"^[ \t]*", line).group(0)


def dedent_by_prefix(line, prefix):
    if prefix and line.startswith(prefix):
        return line[len(prefix):]
    return line


def compact_paragraph(lines):
    out = []
    buf = ""
    base_indent = min(indent for _, indent in lines) if lines else 0
    for line, indent in lines:
        rel_indent = max(0, indent - base_indent)
        if is_list_item(line):
            if buf:
                out.append(buf)
                buf = ""
            out.append((" " * rel_indent) + line)
        elif out and is_list_item_with_indent(out[-1]) and not buf and rel_indent >= 2:
            out[-1] += " " + line
        else:
            buf = line if not buf else buf + " " + line
    if buf:
        out.append(buf)
    return "\n".join(out)


def clean_text(text):
    text = text.replace("\r\n", "\n").replace("\r", "\n")

    result = []
    paragraph = []
    code_block = []
    in_code_fence = False
    code_fence_indent = ""

    for raw_line in text.split("\n"):
        line = re.sub(r"\s+$", "", raw_line)

        if in_code_fence:
            if is_code_fence_line(line):
                code_block.append(line.strip())
                result.append("\n".join(code_block))
                code_block = []
                in_code_fence = False
                code_fence_indent = ""
            else:
                code_block.append(dedent_by_prefix(line, code_fence_indent))
            continue

        if is_code_fence_line(line):
            if paragraph:
                result.append(compact_paragraph(paragraph))
                paragraph = []
            in_code_fence = True
            code_fence_indent = leading_whitespace(line)
            code_block = [line.strip()]
            continue

        indent_match = re.match(r"^[ \t]+", line)
        indent = len(indent_match.group(0)) if indent_match else 0
        cleaned = line.lstrip()
        if cleaned.startswith("\u23fa"):  # ⏺
            cleaned = cleaned[1:].lstrip()
        if re.match(r"^[◦▪]\s+", cleaned):
            indent += 2
        cleaned = normalize_bullet_marker(cleaned)

        if not cleaned:
            if paragraph:
                result.append(compact_paragraph(paragraph))
                paragraph = []
        else:
            paragraph.append((cleaned, indent))

    if paragraph:
        result.append(compact_paragraph(paragraph))
    if code_block:
        result.append("\n".join(code_block))

    return "\n\n".join(result)


if __name__ == "__main__":
    text = get_clipboard()
    cleaned = clean_text(text)
    set_clipboard(cleaned)
    notify("Clipboard cleaned")
